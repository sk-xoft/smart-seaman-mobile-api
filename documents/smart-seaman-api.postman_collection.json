{
  "info": {
    "_postman_id": "smart-seaman-mobile-api",
    "name": "Smart Seaman Mobile API",
    "description": "REST API for maritime training and certification management.\n\n**Base URL**: `{{base_url}}`\n\n**Authentication**: Most endpoints require a JWT token. Call `/v1/login` first, then copy `token` from the response into the `token` collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refToken",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user@example.com\",\n  \"password\": \"yourpassword\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/v1/login",
              "host": ["{{base_url}}"],
              "path": ["v1", "login"]
            },
            "description": "Authenticate and receive a JWT token and refresh token."
          }
        },
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"companyCode\": \"COMP001\",\n  \"dateOfBirth\": \"1990-01-15\",\n  \"positionCode\": \"CAPTAIN\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"securepassword\",\n  \"mobileNumber\": \"0812345678\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/v1/register",
              "host": ["{{base_url}}"],
              "path": ["v1", "register"]
            },
            "description": "Register a new user account."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"oldpassword\",\n  \"newPassword\": \"newpassword\",\n  \"confirmPassword\": \"newpassword\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/v1/change-password",
              "host": ["{{base_url}}"],
              "path": ["v1", "change-password"]
            },
            "description": "Change password for the authenticated user."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/refresh-token?refToken={{refToken}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "refresh-token"],
              "query": [{ "key": "refToken", "value": "{{refToken}}" }]
            },
            "description": "Obtain a new JWT access token using the refresh token."
          }
        },
        {
          "name": "Activate User",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/activate-user?uid=ACTIVATION_UID",
              "host": ["{{base_url}}"],
              "path": ["v1", "activate-user"],
              "query": [{ "key": "uid", "value": "ACTIVATION_UID" }]
            },
            "description": "Activate a newly registered user account via email link."
          }
        },
        {
          "name": "Reset Password (Request)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/v1/reset-password",
              "host": ["{{base_url}}"],
              "path": ["v1", "reset-password"]
            },
            "description": "Send a password reset email to the given address."
          }
        },
        {
          "name": "Activate Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"newpassword\",\n  \"confirmPassword\": \"newpassword\",\n  \"uid\": \"RESET_UID_FROM_EMAIL\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/v1/activate-forgot-password",
              "host": ["{{base_url}}"],
              "path": ["v1", "activate-forgot-password"]
            },
            "description": "Set a new password using the reset UID received by email."
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/profile",
              "host": ["{{base_url}}"],
              "path": ["v1", "profile"]
            },
            "description": "Get the authenticated user's profile."
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"companyCode\": \"COMP001\",\n  \"dateOfBirth\": \"1990-01-15\",\n  \"positionCode\": \"CAPTAIN\",\n  \"email\": \"john.doe@example.com\",\n  \"mobileNumber\": \"0812345678\",\n  \"isChangeFile\": \"N\",\n  \"imageProfile\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/v1/profile-update",
              "host": ["{{base_url}}"],
              "path": ["v1", "profile-update"]
            },
            "description": "Update profile data. Set `isChangeFile` to `Y` and provide base64 image in `imageProfile` to update the photo."
          }
        },
        {
          "name": "Get Profile Image",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/profile-image",
              "host": ["{{base_url}}"],
              "path": ["v1", "profile-image"]
            },
            "description": "Download the user's profile image (binary response)."
          }
        },
        {
          "name": "Deactivate Profile",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/v1/profile/inactive",
              "host": ["{{base_url}}"],
              "path": ["v1", "profile", "inactive"]
            },
            "description": "Mark the authenticated user's account as inactive."
          }
        },
        {
          "name": "Activate Profile",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/v1/profile/active",
              "host": ["{{base_url}}"],
              "path": ["v1", "profile", "active"]
            },
            "description": "Re-activate an inactive account by email."
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "List COT Certifications",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/documents/certification/COT?offSet=0",
              "host": ["{{base_url}}"],
              "path": ["v1", "documents", "certification", "COT"],
              "query": [{ "key": "offSet", "value": "0" }]
            },
            "description": "Get a paginated list of COT-type certification documents."
          }
        },
        {
          "name": "List DOC Certifications",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/documents/certification/DOC?offSet=0",
              "host": ["{{base_url}}"],
              "path": ["v1", "documents", "certification", "DOC"],
              "query": [{ "key": "offSet", "value": "0" }]
            },
            "description": "Get a paginated list of DOC-type certification documents."
          }
        },
        {
          "name": "List Expiring Certifications",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/documents/certification/to-expiration?offSet=0",
              "host": ["{{base_url}}"],
              "path": ["v1", "documents", "certification", "to-expiration"],
              "query": [{ "key": "offSet", "value": "0" }]
            },
            "description": "Get certifications that are expiring soon."
          }
        },
        {
          "name": "Create Certification",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentCode\": \"DOC001\",\n  \"certStartDate\": \"2024-01-01\",\n  \"certEndDateType\": \"DATE\",\n  \"certEndDate\": \"2026-12-31\",\n  \"fileCert\": \"\",\n  \"fileCertName\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/v1/documents/certification/create",
              "host": ["{{base_url}}"],
              "path": ["v1", "documents", "certification", "create"]
            },
            "description": "Add a new certification document. Provide base64 file content in `fileCert` and filename in `fileCertName` to attach a file."
          }
        },
        {
          "name": "Update Certification",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isChangeFile\": \"N\",\n  \"documentCode\": \"DOC001\",\n  \"certStartDate\": \"2024-01-01\",\n  \"certEndDateType\": \"DATE\",\n  \"certEndDate\": \"2027-12-31\",\n  \"fileCert\": \"\",\n  \"fileCertName\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/v1/documents/certification/update",
              "host": ["{{base_url}}"],
              "path": ["v1", "documents", "certification", "update"]
            },
            "description": "Update an existing certification. Set `isChangeFile` to `Y` to replace the attached file."
          }
        },
        {
          "name": "Delete Certification",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/v1/documents/certification/delete?certCode=CERT_CODE",
              "host": ["{{base_url}}"],
              "path": ["v1", "documents", "certification", "delete"],
              "query": [{ "key": "certCode", "value": "CERT_CODE" }]
            },
            "description": "Delete a certification by its cert code."
          }
        },
        {
          "name": "Get Certification for Edit",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/documents/certification/edit?certCode=CERT_CODE",
              "host": ["{{base_url}}"],
              "path": ["v1", "documents", "certification", "edit"],
              "query": [{ "key": "certCode", "value": "CERT_CODE" }]
            },
            "description": "Fetch certification details to pre-populate an edit form."
          }
        },
        {
          "name": "View Certification File",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/documents/certification/view?certCode=CERT_CODE",
              "host": ["{{base_url}}"],
              "path": ["v1", "documents", "certification", "view"],
              "query": [{ "key": "certCode", "value": "CERT_CODE" }]
            },
            "description": "Download the attached certification file (binary response)."
          }
        }
      ]
    },
